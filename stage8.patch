+@router.get("/month")
+def get_month_summary(year: int, month: int, db=Depends(get_db)):
+    """Per-day appointment counts for *year*-*month* (used by calendar view)."""
+    if not (1 <= month <= 12):
+        raise HTTPException(422, "month must be 1-12")
+    if not (1900 <= year <= 2100):
+        raise HTTPException(422, "year out of range")
+
+    from calendar import monthrange
+    days_in_month = monthrange(year, month)[1]
+    first = f"{year:04d}-{month:02d}-01"
+    last = f"{year:04d}-{month:02d}-{days_in_month:02d}"
+
+    rows = db.execute(
+        """
+        SELECT sb.date                      AS date,
+               COUNT(DISTINCT a.id)         AS appointment_count,
+               COUNT(sb.id)                 AS block_count
+        FROM schedule_blocks sb
+        LEFT JOIN appointment_services aps ON aps.id = sb.appointment_service_id
+        LEFT JOIN appointments a           ON a.id  = aps.appointment_id
+        WHERE sb.date >= ? AND sb.date <= ?
+        GROUP BY sb.date
+        ORDER BY sb.date
+        """,
+        (first, last),
+    ).fetchall()
+
+    return {
+        "year": year,
+        "month": month,
+        "days_in_month": days_in_month,
+        "days": [dict(r) for r in rows],
+    }
+
