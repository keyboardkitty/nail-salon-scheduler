+function GroupPlanDetail({ plan, members }) {
+  if (!plan) return null;
+  // Group blocks by member_index
+  const byMember = new Map();
+  for (const b of plan.blocks) {
+    const arr = byMember.get(b.member_index) || [];
+    arr.push(b);
+    byMember.set(b.member_index, arr);
+  }
+  const sortedKeys = [...byMember.keys()].sort((a, b) => a - b);
+
+  return (
+    <div>
+      {!plan.feasible && (
+        <div style={S.warnBox}>
+          <strong>Infeasible.</strong>
+          <ul style={{ margin: '6px 0 0 18px' }}>
+            {plan.warnings.map((w, i) => <li key={i}>{w}</li>)}
+          </ul>
+        </div>
+      )}
+      {sortedKeys.map(idx => {
+        const member = members[idx];
+        const color = MEMBER_COLORS[idx % MEMBER_COLORS.length];
+        const blocks = byMember.get(idx);
+        return (
+          <div key={idx} style={{ marginBottom: 12 }}>
+            <div style={{ display: 'flex', alignItems: 'center', gap: 8, marginBottom: 4 }}>
+              <span style={{ ...S.memberPill, background: color }}>
