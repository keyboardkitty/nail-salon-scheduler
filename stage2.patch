+    assert same_technician_required("Nail Art Design", "UV Gel (Hard Gel)") is True
+
+def test_same_tech_gelx_nail_art():
+    assert same_technician_required("GelX Manicure", "Nail Art Design") is True
+
+def test_no_same_tech_pedicure_manicure():
