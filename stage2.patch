+# ===== TASK BUILDING TESTS =====
+
+def test_single_service_task():
+    tasks = build_tasks([SVC_PEDICURE])
+    assert len(tasks) == 1
+    assert tasks[0]["duration_min"] == 35
+
+def test_multi_service_no_merge():
+    tasks = build_tasks([SVC_SPA_PEDI, SVC_UV_FILL])
+    assert len(tasks) == 2
+    # higher priority first
+    assert tasks[0]["priority"] >= tasks[1]["priority"]
+
+def test_merge_uv_gel_nail_art():
+    tasks = build_tasks([SVC_UV_GEL, SVC_NAIL_ART])
+    assert len(tasks) == 1, "UV Gel + Nail Art must merge into one task"
+    assert tasks[0]["duration_min"] == 75 + 30
+    assert "senior" in tasks[0]["allowed_levels"]
+    # nail art alone allows junior, but merged requires senior
+    assert "junior" not in tasks[0]["allowed_levels"]
+
+def test_merge_three_services():
+    """Spa Pedi (any) + UV Gel (senior) + Nail Art (any) ->
+       UV Gel+Nail Art merged (senior only), Spa Pedi separate."""
+    tasks = build_tasks([SVC_SPA_PEDI, SVC_UV_GEL, SVC_NAIL_ART])
+    assert len(tasks) == 2
+    merged = [t for t in tasks if len(t["services"]) > 1]
+    assert len(merged) == 1
+    assert merged[0]["allowed_levels"] == ["senior"]
+
+def test_priority_ordering():
+    tasks = build_tasks([SVC_PEDICURE, SVC_UV_GEL, SVC_GELX])
+    priorities = [t["priority"] for t in tasks]
+    assert priorities == sorted(priorities, reverse=True)
+
