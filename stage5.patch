+# ---------------------------------------------------------------------------
+# Stage 5: lateness + add-on with local re-optimization
+# ---------------------------------------------------------------------------
+from datetime import datetime, timedelta
+
+
+def _shift_time(hhmm: str, minutes: int) -> str:
+    h, m = map(int, hhmm.split(":"))
+    dt = datetime(2000, 1, 1, h, m) + timedelta(minutes=minutes)
+    return dt.strftime("%H:%M")
+
+
+def _appointment_blocks(db, appointment_id: int):
+    """All schedule_blocks belonging to one appointment, sorted by start_time."""
+    return db.execute(
+        """
+        SELECT sb.*, s.name AS service_name
+        FROM schedule_blocks sb
+        JOIN appointment_services aps ON aps.id = sb.appointment_service_id
+        JOIN services s               ON s.id  = aps.service_id
+        WHERE aps.appointment_id = ?
+        ORDER BY sb.start_time
+        """,
+        (appointment_id,),
+    ).fetchall()
+
+
+@router.post("/lateness")
+def apply_lateness(body: LatenessRequest, db=Depends(get_db)):
+    """Customer is *minutes_late*; shift all their remaining blocks by that
+    amount, detecting conflicts. If conflicts exist they are reported as
+    warnings; if `auto_apply` is True and no conflicts, the shift is applied.
+
+    Local re-optimization window: only blocks within the same date are considered.
+    """
+    blocks = _appointment_blocks(db, body.appointment_id)
+    if not blocks:
+        raise HTTPException(404, "No schedule blocks for this appointment")
+
+    proposed = []
+    warnings = []
+    DAY_END = "20:00"
+
+    for b in blocks:
+        new_start = _shift_time(b["start_time"], body.minutes_late)
+        new_end = _shift_time(b["end_time"], body.minutes_late)
+
+        if new_start < "00:00" or new_end > DAY_END:
+            warnings.append(
+                f"{b['service_name']} would extend past day end ({new_end})"
+            )
+
+        # Conflict against other blocks for same tech, same date, excluding self
+        clash = db.execute(
+            "SELECT id, start_time, end_time FROM schedule_blocks "
+            "WHERE technician_id=? AND date=? AND id<>? "
+            "AND start_time < ? AND ? < end_time",
+            (b["technician_id"], b["date"], b["id"], new_end, new_start),
+        ).fetchone()
+        if clash:
+            warnings.append(
+                f"{b['service_name']} {new_start}-{new_end} would clash with "
+                f"block #{clash['id']} ({clash['start_time']}-{clash['end_time']})"
+            )
+
+        proposed.append({
+            "block_id": b["id"],
+            "service_name": b["service_name"],
+            "old_start": b["start_time"],
+            "old_end": b["end_time"],
+            "new_start": new_start,
+            "new_end": new_end,
+        })
+
+    applied = False
+    if body.auto_apply and not warnings:
+        for p in proposed:
+            b = next(x for x in blocks if x["id"] == p["block_id"])
+            db.execute(
+                "UPDATE schedule_blocks SET start_time=?, end_time=? WHERE id=?",
+                (p["new_start"], p["new_end"], b["id"]),
+            )
+            db.execute(
+                "UPDATE appointment_services SET start_time=?, end_time=? WHERE id=?",
+                (
+                    f"{b['date']} {p['new_start']}",
+                    f"{b['date']} {p['new_end']}",
+                    b["appointment_service_id"],
+                ),
+            )
+        db.commit()
+        applied = True
+
+    return {
+        "applied": applied,
+        "minutes_late": body.minutes_late,
+        "proposed": proposed,
+        "warnings": warnings,
+    }
+
+
+@router.post("/add-on")
+def add_on_service(body: AddOnRequest, db=Depends(get_db)):
+    """Add a new service to an existing appointment, finding a slot via the
+    planner.  Honors same-tech rules (e.g. UV Gel + Nail Art must share tech).
+    """
+    import json as _j
+    from scheduler.rules import same_technician_required
+    from scheduler.planner import build_tasks, find_candidates
+
+    appt = db.execute(
+        "SELECT * FROM appointments WHERE id=?", (body.appointment_id,)
+    ).fetchone()
+    if not appt:
+        raise HTTPException(404, "Appointment not found")
+
+    svc_row = db.execute(
+        "SELECT * FROM services WHERE id=? AND is_active=1", (body.service_id,)
+    ).fetchone()
+    if not svc_row:
+        raise HTTPException(404, "Service not found or inactive")
+
+    existing = _appointment_blocks(db, body.appointment_id)
+    if not existing:
+        raise HTTPException(400, "Appointment has no scheduled blocks")
+
+    date = existing[0]["date"]
+    last_end = max(e["end_time"] for e in existing)
+
+    new_svc = dict(svc_row)
+    new_svc["allowed_levels"] = _j.loads(new_svc["allowed_levels"])
+
+    # Detect same-tech requirement with any existing service
+    forced_tech_id = None
+    for e in existing:
+        if same_technician_required(new_svc["name"], e["service_name"]):
+            forced_tech_id = e["technician_id"]
+            break
+
+    # Load all techs (filter to forced one if any)
+    tech_rows = db.execute(
+        "SELECT * FROM technicians WHERE is_active=1"
+    ).fetchall()
+    techs = []
+    for r in tech_rows:
+        d = dict(r)
+        d["extra_permissions"] = _j.loads(d["extra_permissions"] or "[]")
+        techs.append(d)
+    if forced_tech_id is not None:
+        techs = [t for t in techs if t["id"] == forced_tech_id]
+
+    # Existing blocks on this date (for conflict detection during candidate gen)
+    others = db.execute(
+        "SELECT * FROM schedule_blocks WHERE date=?", (date,)
+    ).fetchall()
+    others = [dict(b) for b in others]
+
+    # Build a one-task plan for the new service, anchored to right after last_end
+    tasks = build_tasks([new_svc])
+    cands = find_candidates(tasks[0], techs, others, last_end)
+    if not cands:
+        return {
+            "applied": False,
+            "warnings": [
+                f"No available slot for '{new_svc['name']}'"
+                + (f" with same tech (forced)" if forced_tech_id else "")
+            ],
+        }
+
+    pick = cands[0]
+    proposed = {
+        "service_id": new_svc["id"],
+        "service_name": new_svc["name"],
+        "technician_id": pick["technician"]["id"],
+        "technician_name": pick["technician"]["name"],
+        "technician_level": pick["technician"]["level"],
+        "date": date,
+        "start_time": pick["start_time"],
+        "end_time": pick["end_time"],
+        "reason": pick["reason"],
+        "same_tech_forced": forced_tech_id is not None,
+    }
+
+    if not body.auto_apply:
+        return {"applied": False, "proposed": proposed}
+
+    cur = db.cursor()
+    cur.execute(
+        "INSERT INTO appointment_services "
+        "(appointment_id, service_id, technician_id, start_time, end_time, status) "
+        "VALUES (?, ?, ?, ?, ?, 'scheduled')",
+        (
+            body.appointment_id,
+            new_svc["id"],
+            pick["technician"]["id"],
+            f"{date} {pick['start_time']}",
+            f"{date} {pick['end_time']}",
+        ),
+    )
+    aps_id = cur.lastrowid
+    cur.execute(
+        "INSERT INTO schedule_blocks "
+        "(technician_id, appointment_service_id, date, start_time, end_time, block_type) "
+        "VALUES (?, ?, ?, ?, ?, 'service')",
+        (
+            pick["technician"]["id"],
+            aps_id,
+            date,
+            pick["start_time"],
+            pick["end_time"],
+        ),
+    )
+    block_id = cur.lastrowid
+    db.commit()
+
+    return {
+        "applied": True,
+        "block_id": block_id,
+        "appointment_service_id": aps_id,
+        "proposed": proposed,
+    }
