@@ -0,0 +1,87 @@
+"""
+rules.py — Pure business rules for the scheduling engine.
+No DB access; operates on dicts/dataclasses only.
+"""
+import json
+from typing import Any
+
+# ---------------------------------------------------------------------------
+# Level hierarchy (higher index = more capable)
+# ---------------------------------------------------------------------------
+LEVEL_RANK = {"junior": 0, "mid": 1, "senior": 2}
+
+
+def technician_can_do_service(
+    tech_level: str,
+    allowed_levels: list[str] | str,
+    extra_permissions: list[str] | str | None = None,
+    service_name: str | None = None,
+) -> bool:
+    """Return True if a technician at *tech_level* may perform a service
+    whose *allowed_levels* list is given.  Also checks extra_permissions
+    for explicit service-name overrides."""
+    if isinstance(allowed_levels, str):
+        allowed_levels = json.loads(allowed_levels)
+    if tech_level in allowed_levels:
+        return True
+    # Check extra_permissions override (service name match)
+    if service_name and extra_permissions:
+        if isinstance(extra_permissions, str):
+            extra_permissions = json.loads(extra_permissions)
+        if service_name in extra_permissions:
+            return True
+    return False
+
+
+# ---------------------------------------------------------------------------
+# Same-technician pairing rules
+# ---------------------------------------------------------------------------
+# Pairs of service name patterns that MUST be done by the same tech.
+# Each entry: (pattern_a, pattern_b) — if both appear in one appointment
+# they are merged into one combined task assigned to one tech.
+SAME_TECH_PAIRS: list[tuple[str, str]] = [
+    ("UV Gel (Hard Gel)", "Nail Art Design"),
+    ("UV Gel Fill", "Nail Art Design"),
+    ("GelX Manicure", "Nail Art Design"),
+]
+
+
+def same_technician_required(service_a_name: str, service_b_name: str) -> bool:
+    """Return True if two services must share a single technician."""
+    for pa, pb in SAME_TECH_PAIRS:
+        if (service_a_name == pa and service_b_name == pb) or \
+           (service_a_name == pb and service_b_name == pa):
+            return True
+    return False
+
+
+def service_priority(service: dict[str, Any]) -> float:
+    """Return the scheduling priority (higher = schedule first)."""
+    return float(service.get("priority_weight", 1.0))
+
+
+def allowed_levels_for_group(services: list[dict]) -> list[str]:
+    """Given a list of services that must share a tech, return the
+    intersection of their allowed_levels (the tech must satisfy ALL)."""
+    if not services:
+        return []
+    sets = []
+    for s in services:
+        lvls = s.get("allowed_levels", [])
+        if isinstance(lvls, str):
+            lvls = json.loads(lvls)
+        sets.append(set(lvls))
+    result = sets[0]
+    for st in sets[1:]:
+        result = result & st
+    return sorted(result, key=lambda l: LEVEL_RANK.get(l, 0))
+
+
+def max_priority_in_group(services: list[dict]) -> float:
+    """Return the highest priority_weight among grouped services."""
+    return max(service_priority(s) for s in services) if services else 1.0
+
+
+def total_duration(services: list[dict]) -> int:
+    """Sum of duration_min for a list of services."""
+    return sum(int(s.get("duration_min", 0)) for s in services)
