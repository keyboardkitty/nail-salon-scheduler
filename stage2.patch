+def test_plan_infeasible_no_techs():
+    """If no senior tech, UV Gel should be infeasible."""
+    techs = [BOB, CAROL, DIANA, ETHAN]  # no senior
+    services = [SVC_UV_GEL]
+    tasks = build_tasks(services)
+    plans = generate_plans(tasks, techs, [], "10:00")
+    assert plans[0]["feasible"] is False
+    assert len(plans[0]["warnings"]) > 0
+
+def test_plan_group_booking():
+    """3 customers each want Gel Manicure at 10:00 — all feasible."""
+    services = [SVC_GEL_MANI, SVC_GEL_MANI, SVC_GEL_MANI]
+    tasks = build_tasks(services)
+    plans = generate_plans(tasks, ALL_TECHS, [], "10:00")
+    assert plans[0]["feasible"] is True
+    techs_used = {b["technician_id"] for b in plans[0]["blocks"]}
+    assert len(techs_used) >= 2, "Should spread across multiple techs"
+
+def test_plan_group_infeasible():
+    """6 customers want Gel Manicure at 10:00 with only 5 techs — need overlap."""
+    services = [SVC_GEL_MANI] * 6
+    tasks = build_tasks(services)
+    plans = generate_plans(tasks, ALL_TECHS, [], "10:00")
+    # still feasible because tasks can use different time slots
+    assert plans[0]["feasible"] is True
