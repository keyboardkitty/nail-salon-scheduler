+@router.get("/day/{date}")
+def get_day_schedule(date: str, db=Depends(get_db)):
+    """Return all schedule blocks for *date* grouped by technician."""
+    techs = db.execute(
+        "SELECT id, name, level FROM technicians WHERE is_active=1 ORDER BY id"
+    ).fetchall()
+
+    rows = db.execute(
+        """
+        SELECT sb.id            AS block_id,
+               sb.technician_id AS technician_id,
+               sb.start_time    AS start_time,
+               sb.end_time      AS end_time,
+               sb.block_type    AS block_type,
+               sb.notes         AS block_notes,
+               aps.id           AS aps_id,
+               aps.status       AS aps_status,
+               a.id             AS appointment_id,
+               a.customer_name  AS customer_name,
+               a.status         AS appt_status,
+               s.id             AS service_id,
+               s.name           AS service_name
+        FROM schedule_blocks sb
+        LEFT JOIN appointment_services aps ON aps.id = sb.appointment_service_id
+        LEFT JOIN appointments a           ON a.id  = aps.appointment_id
+        LEFT JOIN services s               ON s.id  = aps.service_id
+        WHERE sb.date = ?
+        ORDER BY sb.technician_id, sb.start_time
+        """,
+        (date,),
+    ).fetchall()
+
+    by_block: dict[int, dict] = {}
+    for r in rows:
+        bid = r["block_id"]
+        if bid not in by_block:
+            by_block[bid] = {
+                "id": bid,
+                "technician_id": r["technician_id"],
+                "start_time": r["start_time"],
+                "end_time": r["end_time"],
+                "block_type": r["block_type"],
+                "notes": r["block_notes"],
+                "appointment_id": r["appointment_id"],
+                "customer_name": r["customer_name"],
+                "status": r["appt_status"] or r["aps_status"] or "scheduled",
+                "service_names": [],
+            }
+        if r["service_name"]:
+            by_block[bid]["service_names"].append(r["service_name"])
+
+    out_techs = []
+    for t in techs:
+        tid = t["id"]
+        blocks = [b for b in by_block.values() if b["technician_id"] == tid]
+        blocks.sort(key=lambda b: b["start_time"])
+        out_techs.append({
+            "id": tid,
+            "name": t["name"],
+            "level": t["level"],
+            "blocks": blocks,
+        })
+
+    return {"date": date, "technicians": out_techs}
+
+
+@router.get("/appointments")
+def list_appointments(date: str | None = None, db=Depends(get_db)):
+    """List appointments, optionally filtered by date (YYYY-MM-DD)."""
+    if date:
+        rows = db.execute(
+            """
+            SELECT DISTINCT a.*
+            FROM appointments a
+            JOIN appointment_services aps ON aps.appointment_id = a.id
+            WHERE substr(aps.start_time, 1, 10) = ?
+            ORDER BY a.id DESC
+            """,
+            (date,),
+        ).fetchall()
+    else:
+        rows = db.execute(
+            "SELECT * FROM appointments ORDER BY id DESC LIMIT 100"
+        ).fetchall()
+    return [dict(r) for r in rows]
