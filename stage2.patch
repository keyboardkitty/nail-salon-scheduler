@@ -0,0 +1,181 @@
+"""
+engine.py — Main scheduling entry point.
+This is the only module that touches the DB; rules.py and planner.py are pure.
+"""
+from __future__ import annotations
+import json
+import sqlite3
+from typing import Any
+
+from scheduler.planner import build_tasks, generate_plans
+
+
+def _row_dict(row: sqlite3.Row) -> dict:
+    d = dict(row)
+    for k in ("allowed_levels", "extra_permissions"):
+        if k in d and isinstance(d[k], str):
+            d[k] = json.loads(d[k])
+    if "is_active" in d:
+        d["is_active"] = bool(d["is_active"])
+    return d
+
+
+def _load_services(db: sqlite3.Connection, service_ids: list[int]) -> list[dict]:
+    placeholders = ",".join("?" for _ in service_ids)
+    rows = db.execute(
+        f"SELECT * FROM services WHERE id IN ({placeholders}) AND is_active=1",
+        service_ids,
+    ).fetchall()
+    svc_map = {r["id"]: _row_dict(r) for r in rows}
+    # preserve request order
+    result = []
+    for sid in service_ids:
+        if sid in svc_map:
+            result.append(svc_map[sid])
+    return result
+
+
+def _load_technicians(db: sqlite3.Connection) -> list[dict]:
+    rows = db.execute(
+        "SELECT * FROM technicians WHERE is_active=1 ORDER BY id"
+    ).fetchall()
+    return [_row_dict(r) for r in rows]
+
+
+def _load_existing_blocks(db: sqlite3.Connection, date: str) -> list[dict]:
+    rows = db.execute(
+        "SELECT * FROM schedule_blocks WHERE date=?", (date,)
+    ).fetchall()
+    return [dict(r) for r in rows]
+
+
+# ---------------------------------------------------------------------------
+# Public API
+# ---------------------------------------------------------------------------
+
+def schedule_appointment(
+    db: sqlite3.Connection,
+    customer_name: str,
+    service_ids: list[int],
+    requested_time: str,
+    num_plans: int = 3,
+) -> dict:
+    """Generate candidate plans for a new appointment.
+
+    Parameters
+    ----------
+    db : sqlite3 connection
+    customer_name : str
+    service_ids : list of service IDs requested
+    requested_time : "YYYY-MM-DD HH:MM"
+    num_plans : how many alternative plans to generate
+
+    Returns
+    -------
+    dict with keys: customer_name, requested_time, date, plans[], services[]
+    """
+    # parse date + time
+    parts = requested_time.strip().split(" ")
+    date_str = parts[0] if len(parts) >= 1 else ""
+    time_str = parts[1] if len(parts) >= 2 else "10:00"
+
+    services = _load_services(db, service_ids)
+    if not services:
+        return {
+            "error": "No valid services found for the given IDs",
+            "service_ids": service_ids,
+        }
+
+    technicians = _load_technicians(db)
+    if not technicians:
+        return {
+            "error": "No active technicians available",
+        }
+
+    existing_blocks = _load_existing_blocks(db, date_str)
+    tasks = build_tasks(services)
+    plans = generate_plans(tasks, technicians, existing_blocks, time_str, num_plans)
+
+    return {
+        "customer_name": customer_name,
+        "requested_time": requested_time,
+        "date": date_str,
+        "services": [{"id": s["id"], "name": s["name"], "duration_min": s["duration_min"]} for s in services],
+        "tasks": [
+            {
+                "services": [s["name"] for s in t["services"]],
+                "duration_min": t["duration_min"],
+                "allowed_levels": t["allowed_levels"],
+                "priority": t["priority"],
+                "merged": len(t["services"]) > 1,
+            }
+            for t in tasks
+        ],
+        "plans": plans,
+    }
+
+
+def confirm_plan(
+    db: sqlite3.Connection,
+    customer_name: str,
+    customer_phone: str,
+    service_ids: list[int],
+    date: str,
+    plan_blocks: list[dict],
+    notes: str = "",
+) -> dict:
+    """Write a confirmed plan to the DB.
+
+    plan_blocks: list of dicts from a plan's "blocks" array.
+    Returns the created appointment + schedule_blocks.
+    """
+    cur = db.cursor()
+
+    # 1) create appointment
+    cur.execute(
+        "INSERT INTO appointments (customer_name, customer_phone, status, notes) "
+        "VALUES (?, ?, 'confirmed', ?)",
+        (customer_name, customer_phone, notes),
+    )
+    appt_id = cur.lastrowid
+
+    created_blocks = []
+    for block in plan_blocks:
+        svc_ids = block.get("service_ids", [])
+        tech_id = block["technician_id"]
+        start = block["start_time"]
+        end = block["end_time"]
+
+        for sid in svc_ids:
+            # 2) create appointment_service
+            cur.execute(
+                "INSERT INTO appointment_services "
+                "(appointment_id, service_id, technician_id, start_time, end_time, status) "
+                "VALUES (?, ?, ?, ?, ?, 'scheduled')",
+                (appt_id, sid, tech_id, f"{date} {start}", f"{date} {end}"),
+            )
+            as_id = cur.lastrowid
+
+            # 3) create schedule_block
+            cur.execute(
+                "INSERT INTO schedule_blocks "
+                "(technician_id, appointment_service_id, date, start_time, end_time, block_type) "
+                "VALUES (?, ?, ?, ?, ?, 'service')",
+                (tech_id, as_id, date, start, end),
+            )
+            created_blocks.append({
+                "schedule_block_id": cur.lastrowid,
+                "appointment_service_id": as_id,
+                "technician_id": tech_id,
+                "date": date,
+                "start_time": start,
+                "end_time": end,
+            })
+
+    db.commit()
+
+    return {
+        "appointment_id": appt_id,
+        "status": "confirmed",
+        "blocks": created_blocks,
+    }
