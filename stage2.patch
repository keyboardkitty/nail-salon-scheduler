+"""API router for scheduling operations."""
+from fastapi import APIRouter, Depends, HTTPException
+from pydantic import BaseModel
+from database import get_db
+from scheduler.engine import schedule_appointment, confirm_plan
+
+router = APIRouter(prefix="/schedule", tags=["scheduler"])
+
+
+class ScheduleRequest(BaseModel):
+    customer_name: str
+    services: list[int]
+    requested_time: str  # "YYYY-MM-DD HH:MM"
+
+
+class ConfirmRequest(BaseModel):
+    customer_name: str
+    customer_phone: str = ""
+    service_ids: list[int]
+    date: str
+    plan_blocks: list[dict]
+    notes: str = ""
+
+
+@router.post("")
+def create_schedule(body: ScheduleRequest, db=Depends(get_db)):
+    if not body.services:
+        raise HTTPException(422, "At least one service is required")
+    result = schedule_appointment(
+        db,
+        customer_name=body.customer_name,
+        service_ids=body.services,
+        requested_time=body.requested_time,
+    )
+    if "error" in result:
+        raise HTTPException(400, result["error"])
+    return result
+
+
+@router.post("/confirm")
+def confirm_schedule(body: ConfirmRequest, db=Depends(get_db)):
+    if not body.plan_blocks:
+        raise HTTPException(422, "plan_blocks is required")
+    result = confirm_plan(
+        db,
+        customer_name=body.customer_name,
+        customer_phone=body.customer_phone,
+        service_ids=body.service_ids,
+        date=body.date,
+        plan_blocks=body.plan_blocks,
+        notes=body.notes,
+    )
+    return result
