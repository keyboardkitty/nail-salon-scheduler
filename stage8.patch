+// ---------------------------------------------------------------------------
+// Calendar — month grid view of every day across any year
+// ---------------------------------------------------------------------------
+function Calendar({ date, onPickDate }) {
+  const today = todayISO();
+  const initial = parseISODate(date) || parseISODate(today);
+  const [view, setView] = useState({ year: initial.year, month: initial.month });
+  const [data, setData] = useState(null);
+  const [err, setErr] = useState(null);
+
+  useEffect(() => {
+    setData(null); setErr(null);
+    fetch(`${API}/schedule/month?year=${view.year}&month=${view.month}`)
+      .then(r => r.json())
+      .then(setData)
+      .catch(e => setErr(e.message));
+  }, [view.year, view.month]);
+
+  const counts = useMemo(() => {
+    const m = {};
+    (data?.days || []).forEach(d => { m[d.date] = d; });
+    return m;
+  }, [data]);
+
+  // Build the 6×7 grid (always 42 cells so layout is stable across months)
+  const dim = daysInMonth(view.year, view.month);
+  const startWeekday = new Date(view.year, view.month - 1, 1).getDay(); // 0=Sun
+  const cells = [];
+  for (let i = 0; i < startWeekday; i++) cells.push(null);
+  for (let d = 1; d <= dim; d++) cells.push(d);
+  while (cells.length < 42) cells.push(null);
+
+  function jump(deltaMonths) {
+    const next = addMonths(view.year, view.month, deltaMonths);
+    setView(next);
+  }
+  function jumpToToday() {
+    const t = parseISODate(todayISO());
+    setView({ year: t.year, month: t.month });
+  }
+  function setYearInput(yStr) {
+    const y = parseInt(yStr, 10);
+    if (Number.isFinite(y) && y >= 1900 && y <= 2100) setView({ ...view, year: y });
+  }
+
+  // Year jump: prev / next year
+  return (
+    <div style={S.card}>
+      <div style={S.calHeader}>
+        <button onClick={() => setView({ ...view, year: view.year - 1 })} style={S.calNav} title="Previous year">«</button>
+        <button onClick={() => jump(-1)} style={S.calNav} title="Previous month">‹</button>
+        <div style={S.calTitle}>
+          <span style={{ fontWeight: 700 }}>{MONTH_NAMES[view.month - 1]}</span>
+          <input
+            type="number"
+            value={view.year}
+            onChange={e => setYearInput(e.target.value)}
+            style={S.calYearInput}
+          />
+        </div>
+        <button onClick={() => jump(+1)} style={S.calNav} title="Next month">›</button>
+        <button onClick={() => setView({ ...view, year: view.year + 1 })} style={S.calNav} title="Next year">»</button>
+        <button onClick={jumpToToday} style={S.miniBtn}>Today</button>
+        {err && <span style={{ ...S.flashErr, marginLeft: 'auto' }}>{err}</span>}
+      </div>
+
+      <div style={S.calGrid}>
+        {WEEKDAYS_SHORT.map((w, i) => (
+          <div
+            key={w}
+            style={{
+              ...S.calWeekday,
+              color: (i === 0 || i === 6) ? '#dc2626' : '#86868b',
+            }}
+          >{w}</div>
+        ))}
+        {cells.map((d, idx) => {
+          if (!d) return <div key={idx} style={S.calCellEmpty} />;
+          const iso = formatISO(view.year, view.month, d);
+          const dayInfo = counts[iso];
+          const isToday = iso === today;
+          const isSelected = iso === date;
+          const dow = (startWeekday + d - 1) % 7;
+          const isWeekend = dow === 0 || dow === 6;
+          return (
+            <button
+              key={idx}
+              onClick={() => onPickDate(iso)}
+              style={{
+                ...S.calCell,
+                ...(isSelected ? S.calCellSelected : {}),
+                ...(isToday && !isSelected ? S.calCellToday : {}),
+              }}
+              title={`${weekdayName(iso)}, ${MONTH_NAMES[view.month - 1]} ${d}`}
+            >
+              <div style={{
+                fontWeight: isToday || isSelected ? 700 : 500,
+                color: isSelected ? '#fff' : (isWeekend ? '#dc2626' : '#1d1d1f'),
+              }}>{d}</div>
+              {dayInfo && dayInfo.appointment_count > 0 && (
+                <div style={{
+                  ...S.calBadge,
+                  background: isSelected ? 'rgba(255,255,255,0.3)' : '#1d1d1f',
+                  color: '#fff',
+                }}>
+                  {dayInfo.appointment_count}
+                </div>
+              )}
+            </button>
+          );
+        })}
+      </div>
+
+      <div style={S.calLegend}>
+        <span><span style={{ ...S.calLegendDot, background: '#1d1d1f' }} /> appointment count</span>
+        <span><span style={{ ...S.calLegendDot, border: '2px solid #1d4ed8', background: 'transparent' }} /> today</span>
+        <span><span style={{ ...S.calLegendDot, background: '#1d1d1f' }} /> selected</span>
+        <span style={{ color: '#dc2626' }}>weekend</span>
+      </div>
+    </div>
+  );
+}
+
