+def test_plan_multi_service_split():
+    """Spa Pedicure + UV Gel Fill + Nail Art -> should split across techs."""
+    services = [SVC_SPA_PEDI, SVC_UV_FILL, SVC_NAIL_ART]
+    tasks = build_tasks(services)
+    plans = generate_plans(tasks, ALL_TECHS, [], "10:00")
+    assert plans[0]["feasible"] is True
+    assert len(plans[0]["blocks"]) == 2  # UV Fill+NailArt merged, Spa separate
