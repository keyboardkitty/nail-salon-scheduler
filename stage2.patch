+# ===== CANDIDATE GENERATION TESTS =====
+
+def test_candidates_uv_gel_senior_only():
+    tasks = build_tasks([SVC_UV_GEL])
+    cands = find_candidates(tasks[0], ALL_TECHS, [], "10:00")
+    tech_names = {c["technician"]["name"] for c in cands}
+    assert "Alice" in tech_names
+    assert "Bob" not in tech_names
+    assert "Diana" not in tech_names
+
+def test_candidates_pedicure_all():
+    tasks = build_tasks([SVC_PEDICURE])
+    cands = find_candidates(tasks[0], ALL_TECHS, [], "10:00")
+    tech_names = {c["technician"]["name"] for c in cands}
+    assert "Alice" in tech_names
+    assert "Diana" in tech_names
+
+def test_conflict_detection():
+    tasks = build_tasks([SVC_PEDICURE])
+    existing = [{"technician_id": 4, "start_time": "10:00", "end_time": "10:35"}]
+    cands = find_candidates(tasks[0], ALL_TECHS, existing, "10:00")
+    diana_at_10 = [c for c in cands
+                   if c["technician"]["name"] == "Diana" and c["start_time"] == "10:00"]
+    assert len(diana_at_10) == 0, "Diana should be blocked at 10:00"
