+def test_plan_senior_priority():
+    """UV Gel (senior-only) should go to Alice, not mid/junior."""
+    services = [SVC_UV_GEL]
+    tasks = build_tasks(services)
+    plans = generate_plans(tasks, ALL_TECHS, [], "10:00")
+    assert plans[0]["blocks"][0]["technician_name"] == "Alice"
