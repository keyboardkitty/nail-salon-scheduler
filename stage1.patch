@@ -0,0 +1,107 @@
+"""CRUD endpoints for services."""
+import json
+from fastapi import APIRouter, Depends, HTTPException
+from pydantic import BaseModel
+from typing import Optional
+from database import get_db
+
+router = APIRouter(prefix="/services", tags=["services"])
+
+
+# -- Pydantic schemas ---------------------------------------------------------
+class ServiceCreate(BaseModel):
+    name: str
+    duration_min: int
+    allowed_levels: list[str] = ["junior", "mid", "senior"]
+    priority_weight: float = 1.0
+
+
+class ServiceUpdate(BaseModel):
+    name: Optional[str] = None
+    duration_min: Optional[int] = None
+    allowed_levels: Optional[list[str]] = None
+    priority_weight: Optional[float] = None
+    is_active: Optional[bool] = None
+
+
+# -- Helpers ------------------------------------------------------------------
+def _row_to_dict(row):
+    d = dict(row)
+    d["allowed_levels"] = json.loads(d.get("allowed_levels", '["junior","mid","senior"]'))
+    d["is_active"] = bool(d.get("is_active", 1))
+    return d
+
+
+# -- Routes -------------------------------------------------------------------
+@router.get("")
+def list_services(active_only: bool = True, db=Depends(get_db)):
+    if active_only:
+        rows = db.execute("SELECT * FROM services WHERE is_active=1 ORDER BY id").fetchall()
+    else:
+        rows = db.execute("SELECT * FROM services ORDER BY id").fetchall()
+    return [_row_to_dict(r) for r in rows]
+
+
+@router.get("/{svc_id}")
+def get_service(svc_id: int, db=Depends(get_db)):
+    row = db.execute("SELECT * FROM services WHERE id=?", (svc_id,)).fetchone()
+    if not row:
+        raise HTTPException(404, "Service not found")
+    return _row_to_dict(row)
+
+
+@router.post("", status_code=201)
+def create_service(body: ServiceCreate, db=Depends(get_db)):
+    for lvl in body.allowed_levels:
+        if lvl not in ("junior", "mid", "senior"):
+            raise HTTPException(422, f"Invalid level: {lvl}")
+    try:
+        cur = db.execute(
+            "INSERT INTO services (name, duration_min, allowed_levels, priority_weight) "
+            "VALUES (?, ?, ?, ?)",
+            (body.name, body.duration_min, json.dumps(body.allowed_levels), body.priority_weight),
+        )
+        db.commit()
+    except Exception:
+        raise HTTPException(409, "Service name already exists")
+    return get_service(cur.lastrowid, db)
+
+
+@router.patch("/{svc_id}")
+def update_service(svc_id: int, body: ServiceUpdate, db=Depends(get_db)):
+    existing = db.execute("SELECT * FROM services WHERE id=?", (svc_id,)).fetchone()
+    if not existing:
+        raise HTTPException(404, "Service not found")
+
+    updates, params = [], []
+    if body.name is not None:
+        updates.append("name=?"); params.append(body.name)
+    if body.duration_min is not None:
+        updates.append("duration_min=?"); params.append(body.duration_min)
+    if body.allowed_levels is not None:
+        for lvl in body.allowed_levels:
+            if lvl not in ("junior", "mid", "senior"):
+                raise HTTPException(422, f"Invalid level: {lvl}")
+        updates.append("allowed_levels=?"); params.append(json.dumps(body.allowed_levels))
+    if body.priority_weight is not None:
+        updates.append("priority_weight=?"); params.append(body.priority_weight)
+    if body.is_active is not None:
+        updates.append("is_active=?"); params.append(int(body.is_active))
+
+    if not updates:
+        raise HTTPException(422, "No fields to update")
+
+    params.append(svc_id)
+    db.execute(f"UPDATE services SET {', '.join(updates)} WHERE id=?", params)
+    db.commit()
+    return get_service(svc_id, db)
+
+
+@router.delete("/{svc_id}")
+def delete_service(svc_id: int, db=Depends(get_db)):
+    row = db.execute("SELECT * FROM services WHERE id=?", (svc_id,)).fetchone()
+    if not row:
+        raise HTTPException(404, "Service not found")
+    db.execute("UPDATE services SET is_active=0 WHERE id=?", (svc_id,))
+    db.commit()
+    return {"deleted": svc_id}
