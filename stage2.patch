+"""
+test_scheduler.py — Unit tests for the scheduling engine.
+Run:  cd backend && python -m pytest test_scheduler.py -v
+"""
+import json
+import sys
+import os
+sys.path.insert(0, os.path.dirname(__file__))
+
+from scheduler.rules import (
+    technician_can_do_service,
+    same_technician_required,
+    allowed_levels_for_group,
+)
+from scheduler.planner import build_tasks, generate_plans, find_candidates
+
+
+# ---------------------------------------------------------------------------
+# Fixture helpers
+# ---------------------------------------------------------------------------
+def make_svc(id, name, dur, levels, pw=1.0):
+    return {"id": id, "name": name, "duration_min": dur,
+            "allowed_levels": levels, "priority_weight": pw}
+
+def make_tech(id, name, level, extra=None):
+    return {"id": id, "name": name, "level": level,
+            "extra_permissions": extra or [], "is_active": 1}
+
+# Seed data mirrors init_db.py
+SVC_PEDICURE    = make_svc(1, "Regular Pedicure",  35, ["junior","mid","senior"], 1.0)
+SVC_GEL_MANI    = make_svc(2, "Gel Manicure",      45, ["junior","mid","senior"], 1.0)
+SVC_GEL_PEDI    = make_svc(3, "Gel Pedicure",      50, ["junior","mid","senior"], 1.0)
+SVC_SNS         = make_svc(4, "SNS Manicure",      45, ["junior","mid","senior"], 1.0)
+SVC_GELX        = make_svc(5, "GelX Manicure",     60, ["mid","senior"],          2.0)
+SVC_SPA_PEDI    = make_svc(6, "Spa Pedicure",      50, ["junior","mid","senior"], 1.0)
+SVC_NAIL_ART    = make_svc(7, "Nail Art Design",   30, ["junior","mid","senior"], 1.0)
+SVC_UV_GEL      = make_svc(8, "UV Gel (Hard Gel)", 75, ["senior"],               3.0)
+SVC_UV_FILL     = make_svc(9, "UV Gel Fill",       60, ["mid","senior"],          2.5)
+
+ALICE = make_tech(1, "Alice",  "senior")
+BOB   = make_tech(2, "Bob",    "mid")
+CAROL = make_tech(3, "Carol",  "mid")
+DIANA = make_tech(4, "Diana",  "junior")
+ETHAN = make_tech(5, "Ethan",  "junior")
+ALL_TECHS = [ALICE, BOB, CAROL, DIANA, ETHAN]
+
+
+# ===== RULES TESTS =====
+
+def test_hard_gel_only_senior():
+    assert technician_can_do_service("senior", ["senior"]) is True
+    assert technician_can_do_service("mid",    ["senior"]) is False
+    assert technician_can_do_service("junior", ["senior"]) is False
+
+def test_uv_gel_fill_mid_senior():
+    assert technician_can_do_service("senior", ["mid","senior"]) is True
+    assert technician_can_do_service("mid",    ["mid","senior"]) is True
+    assert technician_can_do_service("junior", ["mid","senior"]) is False
+
+def test_gelx_mid_senior():
+    assert technician_can_do_service("senior", ["mid","senior"]) is True
+    assert technician_can_do_service("mid",    ["mid","senior"]) is True
+    assert technician_can_do_service("junior", ["mid","senior"]) is False
+
+def test_junior_cannot_do_restricted():
+    assert technician_can_do_service("junior", ["senior"]) is False
+    assert technician_can_do_service("junior", ["mid","senior"]) is False
+
+def test_all_levels_service():
