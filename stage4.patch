+# ---------------------------------------------------------------------------
+# Stage 4: drag/drop & conflict checking
+# ---------------------------------------------------------------------------
+import json as _json
+
+
+def _time_overlaps(s1: str, e1: str, s2: str, e2: str) -> bool:
+    return s1 < e2 and s2 < e1
+
+
+def _block_services(db, block_id: int) -> list[dict]:
+    """Return services attached to a schedule_block via its appointment_service."""
+    rows = db.execute(
+        """
+        SELECT s.id, s.name, s.duration_min, s.allowed_levels
+        FROM schedule_blocks sb
+        JOIN appointment_services aps ON aps.id = sb.appointment_service_id
+        JOIN services s ON s.id = aps.service_id
+        WHERE sb.id = ?
+        """,
+        (block_id,),
+    ).fetchall()
+    out = []
+    for r in rows:
+        d = dict(r)
+        d["allowed_levels"] = _json.loads(d["allowed_levels"])
+        out.append(d)
+    return out
+
+
+@router.patch("/blocks/{block_id}")
+def update_block(block_id: int, body: UpdateBlockRequest, db=Depends(get_db)):
+    """Move or reassign a schedule block.
+
+    Validates:
+      - technician (if changed) is qualified for ALL services on this block
+      - new time slot doesn't conflict with other blocks for that technician
+    Returns updated block dict; 409 on conflict, 422 on permission failure.
+    """
+    blk = db.execute(
+        "SELECT * FROM schedule_blocks WHERE id=?", (block_id,)
+    ).fetchone()
+    if not blk:
+        raise HTTPException(404, "Block not found")
+
+    new_tech_id = body.technician_id if body.technician_id is not None else blk["technician_id"]
+    new_start = body.start_time if body.start_time else blk["start_time"]
+    new_end = body.end_time if body.end_time else blk["end_time"]
+
+    if new_start >= new_end:
+        raise HTTPException(422, "start_time must be before end_time")
+
+    # Check technician qualification against this block's services
+    tech = db.execute(
+        "SELECT * FROM technicians WHERE id=? AND is_active=1", (new_tech_id,)
+    ).fetchone()
+    if not tech:
+        raise HTTPException(422, "Technician not found or inactive")
+
+    services = _block_services(db, block_id)
+    extra = _json.loads(tech["extra_permissions"] or "[]")
+    for svc in services:
+        if tech["level"] not in svc["allowed_levels"] and svc["name"] not in extra:
+            raise HTTPException(
+                422,
+                f"{tech['name']} ({tech['level']}) cannot perform '{svc['name']}'",
+            )
+
+    # Conflict check against other blocks for this tech on the same date
+    others = db.execute(
+        "SELECT id, start_time, end_time FROM schedule_blocks "
+        "WHERE technician_id=? AND date=? AND id<>?",
+        (new_tech_id, blk["date"], block_id),
+    ).fetchall()
+    for o in others:
+        if _time_overlaps(new_start, new_end, o["start_time"], o["end_time"]):
+            raise HTTPException(
+                409,
+                f"Conflicts with block #{o['id']} ({o['start_time']}-{o['end_time']})",
+            )
+
+    # Apply updates
+    db.execute(
+        "UPDATE schedule_blocks SET technician_id=?, start_time=?, end_time=? WHERE id=?",
+        (new_tech_id, new_start, new_end, block_id),
+    )
+    # Mirror to appointment_services so timestamps stay consistent
+    db.execute(
+        "UPDATE appointment_services SET technician_id=?, start_time=?, end_time=? "
+        "WHERE id=?",
+        (
+            new_tech_id,
+            f"{blk['date']} {new_start}",
+            f"{blk['date']} {new_end}",
+            blk["appointment_service_id"],
+        ),
+    )
+    db.commit()
+
+    updated = db.execute(
+        "SELECT * FROM schedule_blocks WHERE id=?", (block_id,)
+    ).fetchone()
+    return dict(updated)
+
+
+@router.delete("/blocks/{block_id}")
+def delete_block(block_id: int, db=Depends(get_db)):
+    """Cancel a single schedule block (and its appointment_service)."""
+    blk = db.execute(
+        "SELECT * FROM schedule_blocks WHERE id=?", (block_id,)
+    ).fetchone()
+    if not blk:
+        raise HTTPException(404, "Block not found")
+
+    db.execute(
+        "UPDATE appointment_services SET status='cancelled' WHERE id=?",
+        (blk["appointment_service_id"],),
+    )
+    db.execute("DELETE FROM schedule_blocks WHERE id=?", (block_id,))
+    db.commit()
+    return {"deleted": block_id}
