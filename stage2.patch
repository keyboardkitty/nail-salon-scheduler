+++ b/backend/scheduler/planner.py
@@ -0,0 +1,287 @@
+"""
+planner.py — Task splitting, merging, and greedy schedule generation.
+Pure logic: receives data dicts, returns plan dicts.  No DB access.
+"""
+from __future__ import annotations
+import json
+from datetime import datetime, timedelta
+from typing import Any
+
+from scheduler.rules import (
+    same_technician_required,
+    technician_can_do_service,
+    allowed_levels_for_group,
+    max_priority_in_group,
+    total_duration,
+    LEVEL_RANK,
+)
+
+# ---------------------------------------------------------------------------
+# Task dataclass-like dict builders
+# ---------------------------------------------------------------------------
+
+def _parse_levels(val):
+    if isinstance(val, str):
+        return json.loads(val)
+    return val
+
+
+def _parse_extra(val):
+    if val is None:
+        return []
+    if isinstance(val, str):
+        return json.loads(val)
+    return val
+
+
+def build_tasks(services: list[dict]) -> list[dict]:
+    """Split services into schedulable tasks, merging same-tech pairs.
+
+    Each task = {
+        "services": [svc, ...],        # one or more merged services
+        "duration_min": int,
+        "allowed_levels": [...],
+        "priority": float,
+    }
+    """
+    n = len(services)
+    merged = [False] * n
+    tasks: list[dict] = []
+
+    # 1) find merge groups
+    for i in range(n):
+        if merged[i]:
+            continue
+        group = [services[i]]
+        merged[i] = True
+        for j in range(i + 1, n):
+            if merged[j]:
+                continue
+            # check if j should merge with any member of the current group
+            for g in group:
+                if same_technician_required(g["name"], services[j]["name"]):
+                    group.append(services[j])
+                    merged[j] = True
+                    break
+        tasks.append({
+            "services": group,
+            "duration_min": total_duration(group),
+            "allowed_levels": allowed_levels_for_group(group),
+            "priority": max_priority_in_group(group),
+        })
+
+    # 2) sort by priority descending (hardest-first / highest weight first)
+    tasks.sort(key=lambda t: -t["priority"])
+    return tasks
+
+
+# ---------------------------------------------------------------------------
+# Availability helpers
+# ---------------------------------------------------------------------------
+
+def _time_add(base: str, minutes: int) -> str:
+    """Add minutes to an HH:MM time string, return HH:MM."""
+    h, m = map(int, base.split(":"))
+    dt = datetime(2000, 1, 1, h, m) + timedelta(minutes=minutes)
+    return dt.strftime("%H:%M")
+
+
+def _time_ge(a: str, b: str) -> bool:
+    return a >= b
+
+
+def _time_lt(a: str, b: str) -> bool:
+    return a < b
+
+
+def _overlaps(s1: str, e1: str, s2: str, e2: str) -> bool:
+    """True if [s1,e1) overlaps [s2,e2)."""
+    return _time_lt(s1, e2) and _time_lt(s2, e1)
+
+
+def find_candidates(
+    task: dict,
+    technicians: list[dict],
+    existing_blocks: list[dict],
+    requested_time: str,
+    day_start: str = "09:00",
+    day_end: str = "19:00",
+    increment: int = 5,
+) -> list[dict]:
+    """Generate candidate (technician, start_time) pairs for a task.
+
+    Scans 5-min increments starting from *requested_time* (then earlier
+    slots, then later slots) and returns scored candidates sorted best-first.
+
+    Each candidate = {
+        "technician": tech dict,
+        "start_time": "HH:MM",
+        "end_time":   "HH:MM",
+        "score": float,
+        "reason": str,
+    }
+    """
+    duration = task["duration_min"]
+    allowed = task["allowed_levels"]
+    service_names = [s["name"] for s in task["services"]]
+
+    eligible_techs = []
+    for t in technicians:
+        tlevel = t["level"]
+        textra = _parse_extra(t.get("extra_permissions"))
+        # tech must satisfy ALL services in the task
+        ok = True
+        for svc in task["services"]:
+            svc_levels = _parse_levels(svc.get("allowed_levels", []))
+            if not technician_can_do_service(tlevel, svc_levels, textra, svc["name"]):
+                ok = False
+                break
+        if ok and t.get("is_active", 1):
+            eligible_techs.append(t)
+
+    if not eligible_techs:
+        return []
+
+    # generate time slots
+    slots: list[str] = []
+    t = day_start
+    while _time_lt(t, day_end):
+        end = _time_add(t, duration)
+        if not _time_lt(day_end, end):  # end <= day_end
+            slots.append(t)
+        t = _time_add(t, increment)
+
+    candidates = []
+    for tech in eligible_techs:
+        tech_blocks = [b for b in existing_blocks if b.get("technician_id") == tech["id"]]
+        for slot in slots:
+            slot_end = _time_add(slot, duration)
+            # conflict check
+            conflict = False
+            for b in tech_blocks:
+                if _overlaps(slot, slot_end, b["start_time"], b["end_time"]):
+                    conflict = True
+                    break
+            if conflict:
+                continue
+
+            # score: prefer requested_time, prefer exact level match, penalize over-qualification
+            score = 100.0
+            # time proximity penalty (1 point per 5 min away from requested)
+            req_h, req_m = map(int, requested_time.split(":"))
+            sl_h, sl_m = map(int, slot.split(":"))
+            dist = abs((sl_h * 60 + sl_m) - (req_h * 60 + req_m))
+            score -= dist * 0.2
+
+            # level match bonus: prefer lowest capable level (senior protection)
+            tech_rank = LEVEL_RANK.get(tech["level"], 0)
+            min_needed = min(LEVEL_RANK.get(l, 0) for l in allowed) if allowed else 0
+            over_qual = tech_rank - min_needed
+            score -= over_qual * 5  # penalize over-qualification
+
+            # senior doing senior-only work gets a bonus
+            if tech["level"] == "senior" and allowed == ["senior"]:
+                score += 10
+
+            reason_parts = []
+            if dist == 0:
+                reason_parts.append("exact requested time")
+            else:
+                reason_parts.append(f"{dist} min from requested")
+            if over_qual == 0:
+                reason_parts.append("exact level match")
+            else:
+                reason_parts.append(f"over-qualified by {over_qual} level(s)")
+            reason = "; ".join(reason_parts)
+
+            candidates.append({
+                "technician": tech,
+                "start_time": slot,
+                "end_time": slot_end,
+                "score": round(score, 2),
+                "reason": reason,
+            })
+
+    candidates.sort(key=lambda c: -c["score"])
+    return candidates
+
+
+# ---------------------------------------------------------------------------
+# Greedy planner with limited backtracking
+# ---------------------------------------------------------------------------
+
+def generate_plans(
+    tasks: list[dict],
+    technicians: list[dict],
+    existing_blocks: list[dict],
+    requested_time: str,
+    num_plans: int = 3,
+) -> list[dict]:
+    """Return up to *num_plans* distinct schedule plans.
+
+    Each plan = {
+        "label": "Plan A" | "Plan B" | ...,
+        "blocks": [ {task, technician, start_time, end_time, score, reason}, ... ],
+        "total_score": float,
+        "feasible": bool,
+        "warnings": [str],
+    }
+    """
+    labels = ["Plan A", "Plan B", "Plan C", "Plan D", "Plan E"]
+    plans: list[dict] = []
+
+    # We generate plans by trying different top-candidate offsets
+    for plan_idx in range(num_plans):
+        blocks: list[dict] = []
+        used_blocks: list[dict] = list(existing_blocks)  # copy
+        feasible = True
+        warnings: list[str] = []
+
+        for task in tasks:
+            cands = find_candidates(task, technicians, used_blocks, requested_time)
+            if not cands:
+                feasible = False
+                svc_names = ", ".join(s["name"] for s in task["services"])
+                warnings.append(f"No available slot for: {svc_names}")
+                continue
+
+            # pick candidate at offset plan_idx (or last available)
+            pick_idx = min(plan_idx, len(cands) - 1)
+            pick = cands[pick_idx]
+
+            blocks.append({
+                "services": [s["name"] for s in task["services"]],
+                "service_ids": [s["id"] for s in task["services"]],
+                "duration_min": task["duration_min"],
+                "technician_id": pick["technician"]["id"],
+                "technician_name": pick["technician"]["name"],
+                "technician_level": pick["technician"]["level"],
+                "start_time": pick["start_time"],
+                "end_time": pick["end_time"],
+                "score": pick["score"],
+                "reason": pick["reason"],
+            })
+
+            # mark this slot as used for subsequent tasks
+            used_blocks.append({
+                "technician_id": pick["technician"]["id"],
+                "start_time": pick["start_time"],
+                "end_time": pick["end_time"],
+            })
+
+        total_score = round(sum(b["score"] for b in blocks), 2)
+        plans.append({
+            "label": labels[plan_idx] if plan_idx < len(labels) else f"Plan {plan_idx+1}",
+            "blocks": blocks,
+            "total_score": total_score,
+            "feasible": feasible,
+            "warnings": warnings,
+        })
+
+    # sort plans by total_score descending
+    plans.sort(key=lambda p: (-int(p["feasible"]), -p["total_score"]))
+    # re-label after sort
+    for i, p in enumerate(plans):
+        p["label"] = labels[i] if i < len(labels) else f"Plan {i+1}"
+
+    return plans
