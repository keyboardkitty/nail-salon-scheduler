+# ---------------------------------------------------------------------------
+# Stage 7: group bookings (3-4 customers attending together)
+# ---------------------------------------------------------------------------
+def _hydrate_service_row(r):
+    import json as _j
+    d = dict(r)
+    d["allowed_levels"] = _j.loads(d["allowed_levels"])
+    return d
+
+
+def _hydrate_tech_row(r):
+    import json as _j
+    d = dict(r)
+    d["extra_permissions"] = _j.loads(d.get("extra_permissions") or "[]")
+    return d
+
+
+def _generate_group_plans(all_tasks, technicians, existing_blocks, requested_time, num_plans=3):
+    """Like planner.generate_plans but tasks carry member_index/customer_name
+    that we propagate into each block."""
+    from scheduler.planner import find_candidates
+
+    labels = ["Plan A", "Plan B", "Plan C", "Plan D", "Plan E"]
+    plans = []
+
+    for plan_idx in range(num_plans):
+        blocks = []
+        used = list(existing_blocks)
+        feasible = True
+        warnings = []
+
+        for task in all_tasks:
+            cands = find_candidates(task, technicians, used, requested_time)
+            if not cands:
+                feasible = False
+                warnings.append(
+                    f"[{task['customer_name']}] no slot for "
+                    f"{', '.join(s['name'] for s in task['services'])}"
+                )
+                continue
+            pick = cands[min(plan_idx, len(cands) - 1)]
+            blocks.append({
+                "member_index": task["member_index"],
+                "customer_name": task["customer_name"],
+                "services": [s["name"] for s in task["services"]],
+                "service_ids": [s["id"] for s in task["services"]],
+                "duration_min": task["duration_min"],
+                "technician_id": pick["technician"]["id"],
+                "technician_name": pick["technician"]["name"],
+                "technician_level": pick["technician"]["level"],
+                "start_time": pick["start_time"],
+                "end_time": pick["end_time"],
+                "score": pick["score"],
+                "reason": pick["reason"],
+            })
+            used.append({
+                "technician_id": pick["technician"]["id"],
+                "start_time": pick["start_time"],
+                "end_time": pick["end_time"],
+            })
+
+        plans.append({
+            "label": labels[plan_idx] if plan_idx < len(labels) else f"Plan {plan_idx+1}",
+            "blocks": blocks,
+            "total_score": round(sum(b["score"] for b in blocks), 2),
+            "feasible": feasible,
+            "warnings": warnings,
+        })
+
+    plans.sort(key=lambda p: (-int(p["feasible"]), -p["total_score"]))
+    for i, p in enumerate(plans):
+        p["label"] = labels[i] if i < len(labels) else f"Plan {i+1}"
+    return plans
+
+
+@router.post("/group")
+def schedule_group(body: GroupRequest, db=Depends(get_db)):
+    """Generate plans for a group booking (3-4 customers attending together).
+    All members aim to start near the same requested_time. The planner picks
+    different technicians for each member's tasks (no double-booking)."""
+    from scheduler.planner import build_tasks
+
+    if not body.members:
+        raise HTTPException(422, "At least one member required")
+    if len(body.members) > 8:
+        raise HTTPException(422, "Group size cannot exceed 8")
+    for m in body.members:
+        if not m.customer_name.strip():
+            raise HTTPException(422, "Each member needs a customer_name")
+        if not m.services:
+            raise HTTPException(422, f"Member '{m.customer_name}' has no services")
+
+    parts = body.requested_time.strip().split(" ")
+    date_str = parts[0] if parts else ""
+    time_str = parts[1] if len(parts) >= 2 else "10:00"
+
+    # Build flat task list, tagged per member
+    all_tasks = []
+    for idx, m in enumerate(body.members):
+        placeholders = ",".join("?" for _ in m.services)
+        rows = db.execute(
+            f"SELECT * FROM services WHERE id IN ({placeholders}) AND is_active=1",
+            m.services,
+        ).fetchall()
+        if not rows:
+            raise HTTPException(400, f"No valid services for '{m.customer_name}'")
+        svc_map = {r["id"]: _hydrate_service_row(r) for r in rows}
+        ordered = [svc_map[sid] for sid in m.services if sid in svc_map]
+        for t in build_tasks(ordered):
+            t["member_index"] = idx
+            t["customer_name"] = m.customer_name
+            all_tasks.append(t)
+
+    # Hardest-first across the entire group (so senior-only tasks reserved early)
+    all_tasks.sort(key=lambda t: -t["priority"])
+
+    tech_rows = db.execute(
+        "SELECT * FROM technicians WHERE is_active=1 ORDER BY id"
+    ).fetchall()
+    technicians = [_hydrate_tech_row(r) for r in tech_rows]
+
+    existing = db.execute(
+        "SELECT * FROM schedule_blocks WHERE date=?", (date_str,)
+    ).fetchall()
+    existing_blocks = [dict(b) for b in existing]
+
+    plans = _generate_group_plans(all_tasks, technicians, existing_blocks, time_str)
+
+    return {
+        "members": [
+            {"index": i, "customer_name": m.customer_name, "services": m.services}
+            for i, m in enumerate(body.members)
+        ],
+        "requested_time": body.requested_time,
+        "date": date_str,
+        "plans": plans,
+    }
+
+
+@router.post("/group/confirm")
+def confirm_group(body: GroupConfirmRequest, db=Depends(get_db)):
+    """Write a confirmed group plan: one appointment per member, all sharing
+    a generated group_id. Each plan_block must carry member_index."""
+    import uuid
+
+    if not body.plan_blocks:
+        raise HTTPException(422, "plan_blocks is required")
+    if not body.members:
+        raise HTTPException(422, "members is required")
+
+    group_id = uuid.uuid4().hex[:12]
+    cur = db.cursor()
+    out_appts = []
+
+    for idx, m in enumerate(body.members):
+        cur.execute(
+            "INSERT INTO appointments "
+            "(customer_name, customer_phone, status, group_id, notes) "
+            "VALUES (?, ?, 'confirmed', ?, ?)",
+            (m.customer_name, m.customer_phone, group_id, m.notes or ""),
+        )
+        appt_id = cur.lastrowid
+
+        member_blocks = [b for b in body.plan_blocks if b.get("member_index") == idx]
+        created = []
+        for blk in member_blocks:
+            for sid in blk.get("service_ids", []):
+                cur.execute(
+                    "INSERT INTO appointment_services "
+                    "(appointment_id, service_id, technician_id, start_time, end_time, status) "
+                    "VALUES (?, ?, ?, ?, ?, 'scheduled')",
+                    (
+                        appt_id, sid, blk["technician_id"],
+                        f"{body.date} {blk['start_time']}",
+                        f"{body.date} {blk['end_time']}",
+                    ),
+                )
+                aps_id = cur.lastrowid
+                cur.execute(
+                    "INSERT INTO schedule_blocks "
+                    "(technician_id, appointment_service_id, date, start_time, end_time, block_type) "
+                    "VALUES (?, ?, ?, ?, ?, 'service')",
+                    (
+                        blk["technician_id"], aps_id, body.date,
+                        blk["start_time"], blk["end_time"],
+                    ),
+                )
+                created.append({
+                    "block_id": cur.lastrowid,
+                    "appointment_service_id": aps_id,
+                })
+
+        out_appts.append({
+            "appointment_id": appt_id,
+            "customer_name": m.customer_name,
+            "blocks": created,
+        })
+
+    db.commit()
+    return {"group_id": group_id, "appointments": out_appts}
