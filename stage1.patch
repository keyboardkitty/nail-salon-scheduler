+"""CRUD endpoints for technicians."""
+import json
+from fastapi import APIRouter, Depends, HTTPException
+from pydantic import BaseModel
+from typing import Optional
+from database import get_db
+
+router = APIRouter(prefix="/technicians", tags=["technicians"])
+
+
+# -- Pydantic schemas ---------------------------------------------------------
+class TechnicianCreate(BaseModel):
+    name: str
+    level: str  # junior | mid | senior
+    extra_permissions: list[str] = []
+
+
+class TechnicianUpdate(BaseModel):
+    name: Optional[str] = None
+    level: Optional[str] = None
+    is_active: Optional[bool] = None
+    extra_permissions: Optional[list[str]] = None
+
+
+# -- Helpers ------------------------------------------------------------------
+def _row_to_dict(row):
+    d = dict(row)
+    d["extra_permissions"] = json.loads(d.get("extra_permissions", "[]"))
+    d["is_active"] = bool(d.get("is_active", 1))
+    return d
+
+
+# -- Routes -------------------------------------------------------------------
+@router.get("")
+def list_technicians(active_only: bool = True, db=Depends(get_db)):
+    if active_only:
+        rows = db.execute("SELECT * FROM technicians WHERE is_active=1 ORDER BY id").fetchall()
+    else:
+        rows = db.execute("SELECT * FROM technicians ORDER BY id").fetchall()
+    return [_row_to_dict(r) for r in rows]
+
+
+@router.get("/{tech_id}")
+def get_technician(tech_id: int, db=Depends(get_db)):
+    row = db.execute("SELECT * FROM technicians WHERE id=?", (tech_id,)).fetchone()
+    if not row:
+        raise HTTPException(404, "Technician not found")
+    return _row_to_dict(row)
+
+
+@router.post("", status_code=201)
+def create_technician(body: TechnicianCreate, db=Depends(get_db)):
+    if body.level not in ("junior", "mid", "senior"):
+        raise HTTPException(422, "level must be junior, mid, or senior")
+    cur = db.execute(
+        "INSERT INTO technicians (name, level, extra_permissions) VALUES (?, ?, ?)",
+        (body.name, body.level, json.dumps(body.extra_permissions)),
+    )
+    db.commit()
+    return get_technician(cur.lastrowid, db)
+
+
+@router.patch("/{tech_id}")
+def update_technician(tech_id: int, body: TechnicianUpdate, db=Depends(get_db)):
+    existing = db.execute("SELECT * FROM technicians WHERE id=?", (tech_id,)).fetchone()
+    if not existing:
+        raise HTTPException(404, "Technician not found")
+
+    updates, params = [], []
+    if body.name is not None:
+        updates.append("name=?"); params.append(body.name)
+    if body.level is not None:
+        if body.level not in ("junior", "mid", "senior"):
+            raise HTTPException(422, "level must be junior, mid, or senior")
+        updates.append("level=?"); params.append(body.level)
+    if body.is_active is not None:
+        updates.append("is_active=?"); params.append(int(body.is_active))
+    if body.extra_permissions is not None:
+        updates.append("extra_permissions=?"); params.append(json.dumps(body.extra_permissions))
+
+    if not updates:
+        raise HTTPException(422, "No fields to update")
+
+    params.append(tech_id)
+    db.execute(f"UPDATE technicians SET {', '.join(updates)} WHERE id=?", params)
+    db.commit()
+    return get_technician(tech_id, db)
+
+
+@router.delete("/{tech_id}")
+def delete_technician(tech_id: int, db=Depends(get_db)):
+    row = db.execute("SELECT * FROM technicians WHERE id=?", (tech_id,)).fetchone()
+    if not row:
+        raise HTTPException(404, "Technician not found")
+    db.execute("UPDATE technicians SET is_active=0 WHERE id=?", (tech_id,))
+    db.commit()
+    return {"deleted": tech_id}
